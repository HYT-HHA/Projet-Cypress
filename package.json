{
  "name": "mon-projet-cypress",
  "version": "1.0.0",
  "description": "Tests automatisés Cypress + Cucumber (Gherkin en français)",
  "private": true,
  "scripts": {
    "cy:open": "cypress open --e2e --browser chrome",
    "test": "cypress run --e2e --browser chrome",
    "test:smoke": "cypress run --e2e --browser chrome --expose tags=@smoke"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/step_definitions/**/*.{js,ts}"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.1.0",
    "esbuild": "^0.28.2"
  }
}
